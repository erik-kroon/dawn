{
  "name": "dawn",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "hono": "^4.8.2",
      "@orpc/server": "^1.13.14",
      "@orpc/openapi": "^1.13.14",
      "@orpc/zod": "^1.13.14",
      "better-auth": "1.6.11",
      "next-themes": "^0.4.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@orpc/client": "^1.13.14",
      "@polar-sh/better-auth": "^1.8.4",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "@typescript/native-preview": "^7.0.0-dev.20260614.1",
      "alchemy": "^0.91.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "oxlint && oxfmt --write",
    "test": "bun run scripts/run-tests.ts",
    "test:unit": "bun run scripts/run-tests.ts --lane=unit",
    "test:pglite": "bun run scripts/run-tests.ts --lane=pglite",
    "test:postgres": "bun run scripts/run-tests.ts --lane=postgres",
    "test:vitest": "bun run scripts/run-tests.ts --lane=vitest",
    "test:e2e": "bun run scripts/run-tests.ts --lane=e2e",
    "check:ignored-ts": "bun run scripts/check-ignored-typescript.ts",
    "check:migrations": "bun run scripts/check-migrations.ts",
    "check:secrets": "bun run scripts/check-secrets.ts",
    "check:worker": "vp run --filter server build",
    "release:gate": "bun run check:ignored-ts && bun run check:secrets && bun run check:migrations && bun run check-types && bun run test && bun run eval:ai && bun run eval:documents && bun run check && bun run check:worker",
    "test:db": "bun run test:postgres",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "dev:sign": "vp run --filter sign dev",
    "dev:desktop": "vp run --filter desktop dev:hmr",
    "build:desktop": "vp run --filter desktop build:stable",
    "build:desktop:canary": "vp run --filter desktop build:canary",
    "dev:server": "vp run --filter server dev",
    "db:push": "vp run --filter @dawn/db db:push",
    "db:pull": "vp run --filter @dawn/db db:pull",
    "db:introspect": "vp run --filter @dawn/db db:introspect",
    "db:studio": "vp run --filter @dawn/db db:studio",
    "db:generate": "vp run --filter @dawn/db db:generate",
    "db:migrate": "vp run --filter @dawn/db db:migrate",
    "eval:ai": "vp run --filter @dawn/ai eval",
    "eval:documents": "vp run --filter @dawn/documents eval",
    "deploy": "vp run --filter @dawn/infra deploy",
    "destroy": "vp run --filter @dawn/infra destroy"
  },
  "dependencies": {
    "@dawn/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251213.0",
    "@dawn/config": "workspace:*",
    "@types/bun": "^1.3.4",
    "@typescript/native-preview": "catalog:",
    "happy-dom": "^20.10.3",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "rolldown": "1.1.0",
    "typescript": "catalog:",
    "vite-plus": "0.1.24",
    "vitest": "^0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "bun@1.3.9"
}
