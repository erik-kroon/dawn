{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@dawn/api": "workspace:*",
    "@dawn/app": "workspace:*",
    "@dawn/auth": "workspace:*",
    "@dawn/db": "workspace:*",
    "@dawn/env": "workspace:*",
    "@dawn/infra": "workspace:*",
    "@dawn/jobs": "workspace:*",
    "@dawn/sync": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "evlog": "^2.18.1",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dawn/config": "workspace:*",
    "@types/bun": "^1.3.4",
    "tsdown": "^0.21.9",
    "typescript": "catalog:"
  }
}
